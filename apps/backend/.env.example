# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Frontend origin allowed by CORS (must match where Nuxt runs)
FRONTEND_URL=http://localhost:3000

# Public base URL of this API, used to build absolute URLs for uploaded images.
# Leave unset to derive it from the incoming request (fine for local dev).
APP_URL=http://localhost:3001

# ── Database (PostgreSQL) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_NAME=klontong_admin

# ── Session ─────────────────────────────────────────────
# Use a strong random string in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in milliseconds (default 1 day)
SESSION_MAX_AGE=86400000
